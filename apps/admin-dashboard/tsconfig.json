{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "typeRoots": ["../../node_modules/@types"],
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@nammabus/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@nammabus/ui-components": ["../../packages/ui-components/src/index.ts"],
      "@nammabus/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/test"]
}
