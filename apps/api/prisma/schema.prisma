// Prisma schema for NammaBus AI
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  DRIVER
  ADMIN
}

enum TripStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StopEventType {
  ARRIVED
  DEPARTED
}

enum NotificationType {
  TRIP_STARTED
  ETA_10_MIN
  STOP_REACHED
  DELAY
  CANCELLATION
  BREAKDOWN
  ROUTE_ANOMALY
  BROADCAST
}

enum IncidentType {
  BREAKDOWN
  ACCIDENT
  DELAY
  SOS
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         UserRole       @default(STUDENT)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student      Student?
  driver       Driver?
  refreshTokens RefreshToken[]
  notifications Notification[]
  reportedIncidents Incident[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Student {
  id            String         @id @default(uuid())
  userId        String         @unique
  usn           String         @unique
  name          String
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([usn])
  @@map("students")
}

model Driver {
  id            String   @id @default(uuid())
  userId        String   @unique
  licenseNumber String   @unique
  name          String
  phone         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips         Trip[]

  @@index([licenseNumber])
  @@map("drivers")
}

model Bus {
  id                 String         @id @default(uuid())
  busNumber          String         @unique
  registrationNumber String         @unique
  capacity           Int
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  trips              Trip[]
  liveLocations      LiveLocation[]

  @@index([busNumber])
  @@map("buses")
}

model Route {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  routeStops    RouteStop[]
  trips         Trip[]
  subscriptions Subscription[]

  @@index([code])
  @@map("routes")
}

model Stop {
  id                   String         @id @default(uuid())
  name                 String
  code                 String         @unique
  latitude             Float
  longitude            Float
  geofenceRadiusMeters Float          @default(50.0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  routeStops           RouteStop[]
  stopEvents           StopEvent[]
  subscriptions        Subscription[]

  @@index([code])
  @@index([latitude, longitude])
  @@map("stops")
}

model RouteStop {
  id                       String   @id @default(uuid())
  routeId                  String
  stopId                   String
  sequenceOrder            Int
  estimatedMinutesFromStart Int?
  createdAt                DateTime @default(now())

  route                    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop                     Stop     @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@unique([routeId, sequenceOrder])
  @@unique([routeId, stopId])
  @@index([routeId])
  @@index([stopId])
  @@map("route_stops")
}

model Trip {
  id                 String         @id @default(uuid())
  busId              String
  driverId           String
  routeId            String
  status             TripStatus     @default(SCHEDULED)
  scheduledStartTime DateTime?
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  bus                Bus            @relation(fields: [busId], references: [id], onDelete: Restrict)
  driver             Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  route              Route          @relation(fields: [routeId], references: [id], onDelete: Restrict)
  liveLocations      LiveLocation[]
  stopEvents         StopEvent[]
  notifications      Notification[]
  incidents          Incident[]

  @@index([busId])
  @@index([driverId])
  @@index([routeId])
  @@index([status])
  @@index([createdAt])
  @@map("trips")
}

model LiveLocation {
  id        String   @id @default(uuid())
  busId     String
  tripId    String
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime
  createdAt DateTime @default(now())

  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, timestamp])
  @@index([busId, timestamp])
  @@map("live_locations")
}

model StopEvent {
  id        String        @id @default(uuid())
  tripId    String
  stopId    String
  eventType StopEventType
  timestamp DateTime
  createdAt DateTime      @default(now())

  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop      Stop          @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@index([tripId, stopId])
  @@index([timestamp])
  @@map("stop_events")
}

model Subscription {
  id        String   @id @default(uuid())
  studentId String
  stopId    String
  routeId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Restrict)
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([studentId, stopId, routeId])
  @@index([studentId])
  @@index([stopId])
  @@index([routeId])
  @@map("subscriptions")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  tripId      String?
  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now())

  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  trip        Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
  @@index([tripId])
  @@index([createdAt])
  @@map("notifications")
}

model Incident {
  id           String           @id @default(uuid())
  tripId       String?
  reportedById String
  type         IncidentType
  severity     IncidentSeverity @default(MEDIUM)
  description  String
  status       IncidentStatus   @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  trip         Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  reportedBy   User             @relation(fields: [reportedById], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([reportedById])
  @@index([status])
  @@map("incidents")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
