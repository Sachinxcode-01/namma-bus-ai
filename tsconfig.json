{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@prisma/client": [
        "./apps/api/node_modules/.prisma/client",
        "./apps/api/node_modules/@prisma/client",
        "./node_modules/.prisma/client",
        "./node_modules/@prisma/client"
      ],
      ".prisma/client/*": [
        "./apps/api/node_modules/.prisma/client/*",
        "./node_modules/.prisma/client/*"
      ],
      "@nammabus/shared-types": ["./packages/shared-types/src/index.ts"],
      "@nammabus/api-client": ["./packages/api-client/src/index.ts"],
      "@nammabus/ui-components": ["./packages/ui-components/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": [
    "apps/**/*",
    "packages/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "apps/student-mobile",
    "apps/driver-mobile"
  ]
}
