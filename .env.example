# Server Configuration
NODE_ENV=development
PORT=4000
APP_NAME=NammaBus-API

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nammabus_dev?schema=public

# Authentication & Security
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-minimum-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# Observability & Logging
LOG_LEVEL=info

# Optional Services (Deferred to future phases)
# REDIS_URL=redis://localhost:6379
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
