# Server Configuration
NODE_ENV=development
PORT=4000
APP_NAME=NammaBus-API

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nammabus_dev?schema=public

# Authentication & Security
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-minimum-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# Observability & Logging
LOG_LEVEL=info

# Realtime & Distributed Pub/Sub
REALTIME_BACKEND=memory
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
SSE_MAX_CONNECTION_LIFETIME_MS=900000
SSE_MAX_CONCURRENT_PER_USER=10
SSE_MAX_CONCURRENT_PER_IP=30

# Push Notifications (FCM / Firebase Admin)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
